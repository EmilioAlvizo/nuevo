<!-- nuevo/frontend/src/app/admin/components/tabla-a/tabla-a.html -->
<!-- nuevo/frontend/src/app/admin/components/tabla-a/tabla-a.html -->
<div class="contenedor border-round border-1 surface-border shadow-2">
    <p-toolbar class="mb-4">
      <ng-template #start>
        <p-button label="Nuevo" icon="pi pi-plus" class="me-2" (onClick)="openNew()" />
        <p-button
          severity="danger"
          label="Eliminar Seleccionados"
          icon="pi pi-trash"
          outlined
          (onClick)="deleteSelectedArchivos()"
          [disabled]="!selectedArchivos || !selectedArchivos.length"
        />
      </ng-template>
      <ng-template #end>
        <p-button
          label="Exportar"
          icon="pi pi-upload"
          severity="secondary"
          (onClick)="exportCSV($event)"
        />
      </ng-template>
    </p-toolbar>
  
    <p-dialog
      header="Nuevo Archivo Municipal"
      [(visible)]="nuevoArchivoDialog"
      [modal]="true"
      [style]="{ width: '600px' }"
      [draggable]="false"
      [resizable]="false"
    >
      <div class="container-fluid">
        <form #archivoForm="ngForm">
          <!-- Nombre del Archivo -->
          <div class="row mb-3">
            <div class="col-12">
              <label for="nombre" class="form-label fw-semibold">
                Nombre del Archivo <span class="text-danger">*</span>
              </label>
              <input
                type="text"
                pInputText
                id="nombre"
                [(ngModel)]="nuevoArchivo.nombre_archivo"
                name="nombre_archivo"
                class="form-control"
                placeholder="Ej: Encuesta Estatal de Juventud 2019"
                required
                [class.is-invalid]="submitted && !nuevoArchivo.nombre_archivo"
              />
              <div class="invalid-feedback" *ngIf="submitted && !nuevoArchivo.nombre_archivo">
                Este campo es requerido
              </div>
            </div>
          </div>
  
          <!-- Municipio y Tipo -->
          <div class="row mb-3">
            <div class="col-md-6">
              <label for="municipio" class="form-label fw-semibold">
                Municipio <span class="text-danger">*</span>
              </label>
              <p-select
                [options]="municipiosOptions"
                [(ngModel)]="nuevoArchivo.id_municipio"
                name="id_municipio"
                placeholder="Seleccionar municipio"
                optionLabel="label"
                optionValue="value"
                [filter]="true"
                filterPlaceholder="Buscar municipio..."
                [showClear]="true"
                class="w-100"
                [class.ng-invalid]="submitted && !nuevoArchivo.id_municipio"
              >
                <ng-template let-municipio #item>
                  <div class="d-flex align-items-center">
                    <i class="pi pi-map-marker me-2 text-primary"></i>
                    <span>{{ municipio.label }}</span>
                  </div>
                </ng-template>
              </p-select>
              <small class="text-danger" *ngIf="submitted && !nuevoArchivo.id_municipio">
                Campo requerido
              </small>
              <small class="text-muted d-block mt-1" *ngIf="nuevoArchivo.id_municipio">
                <i class="pi pi-info-circle"></i>
                ID seleccionado: {{ nuevoArchivo.id_municipio }}
              </small>
            </div>
  
            <div class="col-md-6">
              <label for="tipo" class="form-label fw-semibold">
                Tipo de Archivo <span class="text-danger">*</span>
              </label>
              <p-select
                [options]="tiposArchivo"
                [(ngModel)]="nuevoArchivo.tipo_archivo"
                name="tipo_archivo"
                placeholder="Seleccionar tipo"
                class="w-100"
                [class.ng-invalid]="submitted && !nuevoArchivo.tipo_archivo"
              />
              <small class="text-danger" *ngIf="submitted && !nuevoArchivo.tipo_archivo">
                Campo requerido
              </small>
            </div>
          </div>
          <!-- Categoría y Subcategoría -->
          <div class="row mb-3">
            <div class="col-md-6">
              <label for="categoria" class="form-label fw-semibold">
                Categoría <span class="text-danger">*</span>
              </label>
              <p-select
                [options]="categorias"
                [(ngModel)]="nuevoArchivo.categoria_archivo"
                name="categoria_archivo"
                placeholder="Seleccionar categoría"
                class="w-100"
                [class.ng-invalid]="submitted && !nuevoArchivo.categoria_archivo"
              />
              @if (isFieldInvalid('categoria_archivo')) {
                <small class="text-danger">
                Campo requerido
              </small>
              }
              
            </div>
  
            <div class="col-md-6">
              <label for="subcategoria" class="form-label fw-semibold"> Subcategoría </label>
              <input
                type="text"
                pInputText
                id="subcategoria"
                [(ngModel)]="nuevoArchivo().subcategoria_archivo"
                name="subcategoria_archivo"
                class="form-control"
                placeholder="Ej: Encuestas"
              />
            </div>
          </div>
  
          <!-- Palabras Clave -->
          <div class="row mb-3">
            <div class="col-12">
              <label for="palabras_clave" class="form-label fw-semibold"> Palabras Clave </label>
              <textarea
                pInputTextarea
                id="palabras_clave"
                [(ngModel)]="nuevoArchivo().palabras_clave"
                name="palabras_clave"
                rows="2"
                class="form-control"
                placeholder="Ej: Encuesta,Juventud,Estatal (separadas por coma)"
              ></textarea>
              <small class="text-muted">
                <i class="pi pi-info-circle"></i>
                Separe las palabras clave con comas
              </small>
            </div>
          </div>
  
          <!-- Estatus -->
          <div class="row mb-3">
            <div class="col-md-6">
              <label for="estatus" class="form-label fw-semibold"> Estatus </label>
              <p-select
                [options]="estatusOptions"
                [(ngModel)]="nuevoArchivo().estatus_archivo"
                name="estatus_archivo"
                optionLabel="label"
                optionValue="value"
                placeholder="Seleccionar estatus"
                class="w-100"
              >
                <ng-template let-option #item>
                  <p-tag [value]="option.label" [severity]="getSeverity(option.value)" />
                </ng-template>
              </p-select>
            </div>
  
            <div class="col-md-6">
              <label class="form-label fw-semibold"> Fecha del Archivo </label>
              <input
                type="text"
                pInputText
                [value]="nuevoArchivo().fecha_archivo"
                class="form-control"
                disabled
              />
              <small class="text-muted">
                <i class="pi pi-calendar"></i>
                Fecha automática
              </small>
            </div>
          </div>
  
          <!-- Subir Archivo -->
          <div class="row mb-3">
            <div class="col-12">
              <label class="form-label fw-semibold">
                Archivo <span class="text-danger">*</span>
              </label>
              <p-fileUpload
                #fileUploader
                mode="basic"
                name="archivo"
                [maxFileSize]="10000000"
                chooseLabel="Seleccionar archivo"
                chooseIcon="pi pi-upload"
                [auto]="false"
                (onSelect)="onArchivoSelect($event)"
                (onClear)="onArchivoRemove()"
                accept=".pdf,.doc,.docx,.xls,.xlsx,.zip,.rar"
                [showUploadButton]="false"
                [showCancelButton]="false"
                class="w-100"
              />
              <small class="text-muted d-block mt-1">
                <i class="pi pi-info-circle"></i>
                Formatos permitidos: PDF, Word, Excel, ZIP, RAR (máx. 10MB)
              </small>
              @if (archivoSeleccionado()) {
              <div class="alert alert-success mt-2 py-2">
                <i class="pi pi-check-circle me-2"></i>
                <strong>{{ archivoSeleccionado()?.name }}</strong>
                <small class="ms-2">({{ formatFileSize(archivoSeleccionado()?.size || 0) }} KB)</small>
              </div>
            } 
            </div>
          </div>
        </form>
      </div>
  
      <ng-template pTemplate="footer">
        <div class="d-flex justify-content-end gap-2">
          <p-button
            label="Cancelar"
            icon="pi pi-times"
            [outlined]="true"
            severity="secondary"
            (onClick)="hideDialog()"
          />
          <p-button label="Guardar Archivo" icon="pi pi-check" (onClick)="guardarNuevoArchivo()" />
        </div>
      </ng-template>
    </p-dialog>
  
    <p-table
      #dt
      [value]="archivos_municipio()"
      [rows]="10"
      [paginator]="true"
      [rowsPerPageOptions]="[10, 25, 50]"
      [globalFilterFields]="[
        'nombre_archivo',
        'nombre_municipio',
        'tipo_archivo',
        'categoria_archivo',
        'subcategoria_archivo',
        'estatus_archivo'
      ]"
      [tableStyle]="{ 'min-width': '50rem' }"
      [(selection)]="selectedArchivos"
      [rowHover]="true"
      dataKey="id_archivo"
      currentPageReportTemplate="Mostrando {first} a {last} de {totalRecords} archivos"
      [showCurrentPageReport]="true"
      [loading]="loading"
      (sortFunction)="customSort($event)"
      [customSort]="true"
      [scrollable]="true"
    >
      <ng-template #caption>
        <div class="d-flex align-items-center justify-content-between">
          <h3 class="m-0">Gestión de Archivos Municipales</h3>
          <div class="d-flex gap-2">
            <p-button
              label="Limpiar Filtros"
              [outlined]="true"
              icon="pi pi-filter-slash"
              (click)="clear(dt)"
            />
            <p-iconfield iconPosition="left">
              <p-inputicon>
                <i class="pi pi-search"></i>
              </p-inputicon>
              <input
                pInputText
                type="text"
                (input)="dt.filterGlobal($event.target.value, 'contains')"
                placeholder="Buscar archivos..."
              />
            </p-iconfield>
          </div>
        </div>
      </ng-template>
  
      <ng-template #header>
        <tr>
          <!-- <th style="width: 3rem">
            <p-tableHeaderCheckbox />
          </th> -->
          <th pFrozenColumn [frozen]="true" pSortableColumn="nombre_archivo" style="min-width: 16rem">
            <div class="d-flex align-items-center justify-content-between">
              Nombre Archivo
              <p-sortIcon field="nombre_archivo" />
              <p-columnFilter type="text" field="nombre_archivo" display="menu" />
            </div>
          </th>
          <th pSortableColumn="nombre_municipio" style="min-width: 14rem">
            <div class="d-flex align-items-center justify-content-between">
              Municipio
              <p-sortIcon field="nombre_municipio" />
              <p-columnFilter type="text" field="nombre_municipio" display="menu" />
            </div>
          </th>
          <th pSortableColumn="tipo_archivo" style="min-width: 10rem">
            <div class="d-flex align-items-center justify-content-between">
              Tipo
              <p-sortIcon field="tipo_archivo" />
              <p-columnFilter field="tipo_archivo" matchMode="equals" display="menu">
                <ng-template #filter let-value let-filter="filterCallback">
                  <p-select
                    [ngModel]="value"
                    [options]="tiposArchivo"
                    (onChange)="filter($event.value)"
                    placeholder="Seleccionar"
                    class="w-100"
                  />
                </ng-template>
              </p-columnFilter>
            </div>
          </th>
          <th pSortableColumn="categoria_archivo" style="min-width: 12rem">
            <div class="d-flex align-items-center justify-content-between">
              Categoría
              <p-sortIcon field="categoria_archivo" />
              <p-columnFilter field="categoria_archivo" matchMode="equals" display="menu">
                <ng-template #filter let-value let-filter="filterCallback">
                  <p-select
                    [ngModel]="value"
                    [options]="categorias"
                    (onChange)="filter($event.value)"
                    placeholder="Seleccionar"
                    class="w-100"
                  />
                </ng-template>
              </p-columnFilter>
            </div>
          </th>
          <th pSortableColumn="subcategoria_archivo" style="min-width: 12rem">
            <div class="d-flex align-items-center justify-content-between">
              Subcategoría
              <p-sortIcon field="subcategoria_archivo" />
              <p-columnFilter type="text" field="subcategoria_archivo" display="menu" />
            </div>
          </th>
          <th pSortableColumn="fecha_archivo" style="min-width: 10rem">
            <div class="d-flex align-items-center justify-content-between">
              Fecha Archivo
              <p-sortIcon field="fecha_archivo" />
              <p-columnFilter type="date" field="fecha_archivo" display="menu" />
            </div>
          </th>
          <th pSortableColumn="fecha_modificacion" style="min-width: 10rem">
            <div class="d-flex align-items-center justify-content-between">
              Modificación
              <p-sortIcon field="fecha_modificacion" />
              <p-columnFilter type="date" field="fecha_modificacion" display="menu" />
            </div>
          </th>
          <th pSortableColumn="estatus_archivo" style="min-width: 10rem">
            <div class="d-flex align-items-center justify-content-between">
              Estatus
              <p-sortIcon field="estatus_archivo" />
              <p-columnFilter field="estatus_archivo" matchMode="equals" display="menu">
                <ng-template #filter let-value let-filter="filterCallback">
                  <p-select
                    [ngModel]="value"
                    [options]="estatusOptions"
                    (onChange)="filter($event.value)"
                    placeholder="Seleccionar"
                    class="w-100"
                    optionLabel="label"
                    optionValue="value"
                  >
                    <ng-template let-option #item>
                      <p-tag [value]="option.label" [severity]="getSeverity(option.value)" />
                    </ng-template>
                  </p-select>
                </ng-template>
              </p-columnFilter>
            </div>
          </th>
          <th style="min-width: 14rem">Acciones</th>
        </tr>
      </ng-template>
  
      <ng-template #body let-archivo>
        <tr>
          <!-- <td style="width: 3rem">
            <p-tableCheckbox [value]="archivo" />
          </td> -->
          <td pFrozenColumn [frozen]="true">
            <div class="d-flex align-items-center gap-2">
              <!-- <i class="pi pi-file fs-5" [ngClass]="getFileIcon(archivo.tipo_archivo)"></i> -->
              <span class="fw-medium">{{ archivo.nombre_archivo }}</span>
            </div>
            <small class="text-muted d-block mt-1" *ngIf="archivo.palabras_clave">
              <!-- <i class="pi pi-tag small"></i> -->
              {{ archivo.palabras_clave }}
            </small>
          </td>
          <td>{{ archivo.nombre_municipio }}</td>
          <td>
            <p-tag [value]="archivo.tipo_archivo" severity="info" />
          </td>
          <td>{{ archivo.categoria_archivo }}</td>
          <td>{{ archivo.subcategoria_archivo }}</td>
          <td>{{ archivo.fecha_archivo | date : 'dd/MM/yyyy' }}</td>
          <td>{{ archivo.fecha_modificacion | date : 'dd/MM/yyyy HH:mm' }}</td>
          <td>
            <p-tag
              [value]="archivo.estatus_archivo"
              [severity]="getSeverity(archivo.estatus_archivo)"
            />
          </td>
          <td>
            <div class="d-flex gap-2">
              <p-button
                icon="pi pi-download"
                [rounded]="true"
                [outlined]="true"
                severity="success"
                pTooltip="Descargar"
                tooltipPosition="top"
                (click)="downloadArchivo(archivo)"
              />
              <p-button
                icon="pi pi-pencil"
                [rounded]="true"
                [outlined]="true"
                pTooltip="Editar"
                tooltipPosition="top"
                (click)="editArchivo(archivo)"
              />
  
              <p-button
                icon="pi pi-trash"
                severity="danger"
                [rounded]="true"
                [outlined]="true"
                pTooltip="Eliminar"
                tooltipPosition="top"
                (click)="deleteArchivo(archivo)"
              />
            </div>
          </td>
        </tr>
      </ng-template>
  
      <ng-template #emptymessage>
        <tr>
          <td colspan="10" class="text-center py-4">
            <i class="pi pi-inbox display-4 text-muted mb-3 d-block"></i>
            <p class="text-muted">No se encontraron archivos.</p>
          </td>
        </tr>
      </ng-template>
    </p-table>
  </div>
  
  <!-- Componentes globales -->
  <p-confirmDialog [style]="{ width: '450px' }" [baseZIndex]="10000" />
  <p-toast position="top-right" [life]="3000" />
  